# ============================================================
# Salin file ini menjadi .env lalu isi. JANGAN commit file .env
# (.env sudah ada di .gitignore).
# Di Vercel: Project > Settings > Environment Variables.
# File contoh ini TIDAK memuat secret asli.
# ============================================================

# --- Rahasia pemicu bot (wajib) ---------------------------------
# String acak panjang. Dipakai sebagai Bearer token saat memanggil /api/tick.
CRON_SECRET=ganti-dengan-string-acak-panjang

# --- Penyimpanan state & log (Vercel) ---------------------------
# Isi dari Vercel KV / Upstash Redis (REST). Kosongkan saat jalan lokal:
# bot otomatis memakai folder ./logs dan ./.data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Kalau memakai integrasi Upstash langsung, nama variabelnya berbeda:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Awalan kunci di Redis. Wajib unik kalau satu database dipakai beberapa bot,
# supaya state dan log tidak saling menimpa.
STORE_PREFIX=indodax-final

# --- Parameter strategi (dibekukan sejak freeze date) -----------
# Jangan diubah setelah freeze. Lihat STRATEGI.md.
STRATEGY_N=150
STRATEGY_M=400
STRATEGY_SL=8
STRATEGY_EXIT_MA=M
MAX_POSITIONS=5
POS_PCT_EQUITY=0.2
MAX_TURNOVER_PCT=0.05
FEE_TAKER_PCT=0.3
MIN_ORDER_IDR=25000
MAX_SPREAD_PCT=2
DAILY_LOSS_LIMIT_PCT=3
TF_MINUTES=60
# Universe dibekukan pada freeze date (lihat STRATEGI.md bagian 7)
UNIVERSE=BTCIDR,ETHIDR,SOLIDR,DOGEIDR,XRPIDR,ADAIDR,BNBIDR,LINKIDR

# --- Kill switch manual (tanpa deploy ulang) --------------------
# Set "1" di environment Vercel, lalu redeploy instan / tunggu re-read.
# Bot juga membaca flag "kill" di storage (lihat README).
KILL_SWITCH=0

# --- Modal awal virtual -----------------------------------------
START_CAPITAL=100000000

# --- Skrip lokal (tidak dipakai di Vercel) ----------------------
# Alamat deployment, untuk scripts/pull_logs.mjs:
#   $env:BOT_URL="https://<project>.vercel.app"; node scripts/pull_logs.mjs
BOT_URL=https://indodax-dryrun-final.vercel.app

# --- Opsional: penarikan data & likuiditas ----------------------
# Dipakai scripts/fetch_history.mjs dan scripts/liquidity.mjs.
# CANDIDATES=BTCIDR,ETHIDR,SOLIDR,DOGEIDR,XRPIDR,ADAIDR,BNBIDR,LINKIDR,TRXIDR,AVAXIDR
# START_DATE=2023-08-29
# UNIVERSE_SIZE=8

# --- Opsional: backtest -----------------------------------------
# Tanpa isian, acuan tanggal = candle terakhir di data/ dan biaya dibaca dari
# data/cost.json yang dibekukan (hasilnya dapat direproduksi persis).
# BT_START=2023-11-10
# BT_END=2026-11-10
# BT_SPREAD_BPS=10
# BT_SLIPPAGE_BPS=5
# BT_RECOMPUTE_COST=1     # ukur ulang spread/slippage dari logs/snapshots.ndjson

# --- Opsional: metadata laporan --------------------------------
# Nilai bawaan sudah sesuai laporan. Mengubahnya mengubah isi
# data/backtest_summary.mjs, jadi jangan diubah setelah freeze.
# STUDENT=Shinta Faradillah Destiany
# NIM=25110200007
# FREEZE_DATE=2026-11-11
